    81	export function startWebhookDispatcher(db: Db, intervalMs = 2000): () => void {
    82	  // SYD-210 Layer B: capture process start once so lease expiry can gate on
    83	  // server uptime — a redeploy's correlated heartbeat outage must not
    84	  // mass-expire live leases before they re-heartbeat.
    85	  const serverStartedAt = Math.floor(Date.now() / 1000);
    86	  const timer = setInterval(() => {
    87	    try {
    88	      emitProcessDeviations(db);
    89	    } catch (err) {
    90	      console.error("process deviation emit:", err);
    91	    }
    92	    dispatchPending(db).catch((err) => console.error("webhook dispatch:", err));
    93	    try {
    94	      // No explicit staleSeconds: releaseStaleClaims reads claims.stale_seconds
    95	      // fresh from settings every tick, so a human's edit in the UI takes
    96	      // effect on the next sweep, not just at process start.
    97	      releaseStaleClaims(db);
    98	    } catch (err) {
    99	      console.error("stale claim release:", err);
   100	    }
   101	    try {
   102	      expireLeases(db, Math.floor(Date.now() / 1000), serverStartedAt);
   103	    } catch (err) {
   104	      console.error("lease expiry sweep:", err);
   105	    }
   106	    try {
   107	      sweepOrphanedAgentSessions(db);
   108	    } catch (err) {
   109	      console.error("orphaned agent session sweep:", err);
   110	    }
   111	  }, intervalMs);
   112	  timer.unref?.();
   113	  return () => clearInterval(timer);
   114	}
