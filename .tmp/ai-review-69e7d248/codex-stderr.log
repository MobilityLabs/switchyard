   484	/**
   485	 * The result of a claim: the updated issue plus the plaintext lease token,
   486	 * handed to the claiming session ONCE (never stored, never re-returned).
   487	 */
   488	export type ClaimResult = { issue: IssueView; leaseToken: string };
   489	
   490	/**
   491	 * SYD-210 Layer B: renew the caller's claim lease on `ref` (resolves the ref,
   492	 * then heartbeatLease gates on the holder's token). Thin adapter-facing wrapper
   493	 * so the ref→issue lookup stays out of leases.ts (which must not import issues).
   494	 */
   495	export function heartbeatClaim(
   496	  db: Db,
   497	  actor: Actor,
   498	  ref: string,
   499	  leaseToken?: string,
   500	): { expiresAt: number } {
   501	  const issue = getIssue(db, ref);
   502	  const lease = heartbeatLease(db, issue.id, actor.id, leaseToken);
   503	  return { expiresAt: lease.expiresAt };
   504	}
   505	
   506	export function claimIssue(
   507	  db: Db,
   508	  actor: Actor,
   509	  ref: string,
   510	  opts: { takeover?: boolean } = {},
   511	): ClaimResult {
   512	  const current = getIssue(db, ref);
   513	  const blockers = getOpenBlockers(db, current.id);
   514	  if (blockers.length > 0) {
   515	    throw new SwitchyardError(
   516	      `${ref} is blocked by ${blockers.map((b) => b.ref).join(", ")} — resolve the blocker first, or call next_task for another issue.`,
   517	    );
   518	  }
   519	
   520	  // Same-actor re-claim of an issue that already has an active lease: fail
   521	  // loudly unless takeover is opted in (this project's workflow tells every
   522	  // session to claim before touching code, and interactive + dispatched
   523	  // sessions share the worker actor — a default takeover would silently kill a
   524	  // healthy running container). Takeover only reaches here for the same actor;
   525	  // a different actor's claim is refused by assertClaimable below.
   526	  if (current.assigneeId === actor.id) {
   527	    const active = getActiveLease(db, current.id);
   528	    if (active && !opts.takeover) {
   529	      throw new SwitchyardError(
   530	        `${ref} already has an active lease held by this actor — another session may be working it. ` +
   531	          `Pass takeover: true to seize the claim (invalidating that session's lease), or call next_task for another issue.`,
   532	      );
   533	    }
   534	    // Re-claim (takeover, or a lease-less holder e.g. after expiry): swap the
   535	    // lease in one transaction. The issue is already in_progress + assigned, so
   536	    // no status change is needed.
   537	    const leaseToken = db.transaction((tx) => {
   538	      if (active) {
   539	        invalidateLease(tx, current.id);
   540	        recordEvent(tx, {
   541	          issueId: current.id,
   542	          actorId: actor.id,
   543	          type: "lease_taken_over",
   544	          payload: {},
   545	        });
   546	      }
   547	      return mintLease(tx, current.id, actor.id, getSetting(db, "claims.lease_ttl_seconds"));
   548	    });
   549	    return { issue: getIssue(db, ref), leaseToken };
   550	  }
   551	
   552	  // Fresh claim of an unassigned (or blocked/PR-guarded) issue: assertClaimable
   553	  // is re-checked inside updateIssue's in_progress gate; the mint happens there
   554	  // via the out-channel.
   555	  assertClaimable(db, actor, current);
   556	  const minted: { token: string | null } = { token: null };
   557	  const issue = updateIssue(db, actor, ref, { status: "in_progress", assigneeName: actor.name }, { minted });
   558	  if (minted.token === null) {
   559	    // Defensive: the auto-claim mint condition should always fire on a fresh
   560	    // claim. If it didn't, the claim state is inconsistent — fail rather than
   561	    // hand back an empty token.
   562	    throw new SwitchyardError(`Failed to mint a lease while claiming ${ref} — retry the claim.`);
   563	  }
   564	  return { issue, leaseToken: minted.token };
   565	}
