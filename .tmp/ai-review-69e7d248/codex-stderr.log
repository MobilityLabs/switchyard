    65	/**
    66	 * Throws unless `token` is the active lease for (issueId, actorId). Pure read.
    67	 * A missing token, no active lease (expired/never-claimed), an actor mismatch,
    68	 * or a superseded token (e.g. after takeover) all reject — this is the
    69	 * SYD-93/122 shared-token close: a second session of the same worker actor
    70	 * holds the shared bearer token but not this lease.
    71	 */
    72	export function validateLease(
    73	  db: DbOrTx,
    74	  issueId: number,
    75	  actorId: number,
    76	  token: string | undefined,
    77	): void {
    78	  const active = token ? getActiveLease(db, issueId) : null;
    79	  if (!active || active.actorId !== actorId || active.tokenHash !== hashToken(token!)) {
    80	    throw new SwitchyardError(
    81	      "This action needs your claim's lease token, which is missing, expired, or superseded — " +
    82	        "call claim_issue to (re)claim this issue and get a fresh lease. If another session took " +
    83	        "it over, that session now owns the work.",
    84	    );
    85	  }
    86	}
