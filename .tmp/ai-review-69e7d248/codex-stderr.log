    16	/**
    17	 * The single active lease of an issue: not invalidated and not past
    18	 * expires_at. At most one by construction (a claim is 1:1 with an issue).
    19	 */
    20	export function getActiveLease(
    21	  db: DbOrTx,
    22	  issueId: number,
    23	  now: number = nowSeconds(),
    24	): ClaimLease | null {
    25	  return (
    26	    db
    27	      .select()
    28	      .from(claimLeases)
    29	      .where(
    30	        and(
    31	          eq(claimLeases.issueId, issueId),
    32	          isNull(claimLeases.invalidatedAt),
    33	          gt(claimLeases.expiresAt, now),
    34	        ),
    35	      )
    36	      .get() ?? null
    37	  );
    38	}
