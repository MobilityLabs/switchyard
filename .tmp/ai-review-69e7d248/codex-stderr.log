    11	// agent-worker.ts imports it via a runtime-computed path so the main
    12	// typecheck and the server Docker image never depend on it. Auth is the same
    13	// CLAUDE_CODE_OAUTH_TOKEN (or ANTHROPIC_API_KEY) from the environment.
    14	
    15	import { appendFileSync } from "node:fs";
