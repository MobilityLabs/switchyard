    40	/**
    41	 * Inserts a fresh lease and returns the plaintext token ONCE. Store only the
    42	 * hash; the plaintext is never re-derivable and never persisted elsewhere.
    43	 * Runs inside the caller's transaction so a lease and its claim are atomic.
    44	 */
    45	export function mintLease(
    46	  tx: DbOrTx,
    47	  issueId: number,
    48	  actorId: number,
    49	  ttlSeconds: number,
    50	): string {
    51	  const token = mintToken("lease");
    52	  const now = nowSeconds();
    53	  tx.insert(claimLeases)
    54	    .values({
    55	      issueId,
    56	      actorId,
    57	      tokenHash: hashToken(token),
    58	      expiresAt: now + ttlSeconds,
    59	      lastBeatAt: now,
    60	    })
    61	    .run();
    62	  return token;
    63	}
