   322	/**
   323	 * Pre-claims `ref` on the tracker host-side, before dispatch (SYD-122):
   324	 * closes the cross-machine race where two workers (or a worker and a
   325	 * coordinating human session) both select the same unassigned todo and spin
   326	 * up sessions before either calls claim_issue — selection and claim are now
   327	 * atomic from this worker's side, not just from the dispatched session's.
   328	 * The host claim mints the session-scoped lease (SYD-210); its plaintext token
   329	 * is returned here ONCE and threaded to the dispatched session out-of-band (an
   330	 * MCP connection header, never argv, never the LLM transcript) so its
   331	 * claim-scoped calls carry the lease, and the host heartbeats it while the
   332	 * session runs. The dispatched session must therefore NOT call claim_issue —
   333	 * a same-actor re-claim against the active lease would fail loudly (see
   334	 * buildPrompt).
   335	 *
   336	 * A refusal (already claimed, now blocked) means another actor won the race
   337	 * — logged and treated as "skip this ref", not an error: it needs no retry
   338	 * bookkeeping here, since the issue's assigneeId will be non-null on the
   339	 * next poll and selectDispatchable naturally stops offering it. Network/5xx
   340	 * failures still retry across a self-deploy restart via withRetry, same as
   341	 * the other tracker writes.
   342	 */
   343	async function claimIssueHost(
   344	  config: WorkerConfig,
   345	  token: string,
   346	  ref: string,
   347	): Promise<string | null> {
   348	  const url = `${config.url.replace(/\/$/, "")}/api/issues/${ref}/claim`;
   349	  try {
   350	    return await withRetry(async () => {
   351	      const res = await fetch(url, {
   352	        method: "POST",
   353	        headers: { authorization: `Bearer ${token}` },
   354	      });
   355	      if (!res.ok) throw new HttpStatusError(res.status, await res.text());
   356	      const body = (await res.json()) as { leaseToken?: string };
   357	      // A claim always mints a lease; an absent token is a server/version
   358	      // mismatch (un-upgraded tracker) — treat as a lost race so we skip
   359	      // rather than dispatch a session that can't authenticate its writes.
   360	      return body.leaseToken ?? null;
   361	    });
   362	  } catch (err) {
   363	    if (err instanceof HttpStatusError && err.status < 500) {
   364	      console.log(`skipping ${ref}: lost the claim race (${err.message})`);
   365	    } else {
   366	      console.error(`could not claim ${ref} before dispatch: ${(err as Error).message}`);
   367	    }
   368	    return null;
   369	  }
   370	}
