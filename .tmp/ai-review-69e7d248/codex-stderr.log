   129	/**
   130	 * Sweep: for every non-invalidated lease past expires_at, atomically release
   131	 * the still-matching in_progress claim (re-assert status/needsInput inside the
   132	 * UPDATE, exactly like releaseStaleClaims — a legit transition that landed
   133	 * first wins the race, .changes === 0 ⇒ skip the event), record
   134	 * claim_released{reason:"lease_expired"}, and mark the lease invalidated (so it
   135	 * leaves future sweeps). Replaces the 4h idle guess for leased claims.
   136	 * Returns the number of issues released.
   137	 *
   138	 * SYD-210 Layer B server-uptime gate: a tracker redeploy is a correlated
   139	 * outage — every container's heartbeats fail at once during the ~5–15s
   140	 * restart. When `serverStartedAt` is given, the sweep is skipped entirely
   141	 * until the server has been continuously up for one full heartbeat window,
   142	 * giving every live container a chance to re-heartbeat before any expiry fires.
   143	 */
   144	export function expireLeases(
   145	  db: Db,
   146	  now: number = nowSeconds(),
   147	  serverStartedAt?: number,
   148	): number {
   149	  if (
   150	    serverStartedAt !== undefined &&
   151	    now - serverStartedAt < getSetting(db, "claims.heartbeat_window_seconds")
   152	  ) {
   153	    return 0;
   154	  }
   155	  const expired = db
   156	    .select()
   157	    .from(claimLeases)
   158	    .where(and(isNull(claimLeases.invalidatedAt), lte(claimLeases.expiresAt, now)))
   159	    .all();
   160	  let released = 0;
   161	  for (const lease of expired) {
   162	    const issue = db.select().from(issues).where(eq(issues.id, lease.issueId)).get();
   163	    const actorId = issue?.assigneeId ?? issue?.creatorId ?? lease.actorId;
   164	    const wasReleased = db.transaction((tx) => {
   165	      // Always invalidate the expired lease, even if the issue moved on, so the
   166	      // next sweep does not re-scan it.
   167	      tx.update(claimLeases)
   168	        .set({ invalidatedAt: sql`(unixepoch())` })
   169	        .where(eq(claimLeases.id, lease.id))
   170	        .run();
   171	      const result = tx
   172	        .update(issues)
   173	        .set({ status: "todo", assigneeId: null, updatedAt: sql`(unixepoch())` })
   174	        .where(
   175	          and(
   176	            eq(issues.id, lease.issueId),
   177	            eq(issues.status, "in_progress"),
   178	            eq(issues.needsInput, false),
   179	          ),
   180	        )
   181	        .run();
   182	      if (result.changes === 0) return false;
   183	      recordEvent(tx, {
   184	        issueId: lease.issueId,
   185	        actorId,
   186	        type: "claim_released",
   187	        payload: { reason: "lease_expired" },
   188	      });
   189	      return true;
   190	    });
   191	    if (wasReleased) released++;
   192	  }
   193	  return released;
   194	}
