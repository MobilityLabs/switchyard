    94	# Codex reads MCP config + auth from $CODEX_HOME (not a CLI flag). The token
    95	# NAME (not value) goes in config.toml, so the bearer never appears in the
    96	# file or in argv (parity with container-entry.sh's /tmp/switchyard-mcp.json
    97	# approach for Claude). The placeholder auth.json carries the REAL account_id
    98	# (non-secret -- codex sends it as the chatgpt-account-id header, which the
    99	# backend matches against the injected token's account); the proxy injects the
   100	# real Authorization: Bearer over the wire.
   101	export CODEX_HOME=/tmp/codex-home
   102	mkdir -p "$CODEX_HOME"
   103	cat > "$CODEX_HOME/config.toml" <<TOMLEOF
   104	[mcp_servers.switchyard]
   105	url = "$SWITCHYARD_URL/mcp"
   106	bearer_token_env_var = "SWITCHYARD_TOKEN"
   107	TOMLEOF
   108	chmod 600 "$CODEX_HOME/config.toml"
