   396	/**
   397	 * Starts the host-side heartbeat loop for a running session and returns a stop
   398	 * function. Every interval it renews the lease; after HEARTBEAT_MISS_LIMIT
   399	 * consecutive failures it calls `onExhausted` (which kills the session) and
   400	 * stops — the honest-liveness cancellation that replaces the 4h idle guess.
   401	 */
   402	function startLeaseHeartbeat(
   403	  config: WorkerConfig,
   404	  token: string,
   405	  leaseToken: string,
   406	  ref: string,
   407	  onExhausted: () => void,
   408	  log: (message: string) => void,
   409	): () => void {
   410	  let failures = 0;
   411	  const timer = setInterval(() => {
   412	    void postHeartbeat(config, token, leaseToken, ref).then((ok) => {
   413	      const r = heartbeatTick(failures, ok);
   414	      failures = r.failures;
   415	      if (!ok) log(`[worker] ${ref}: lease heartbeat failed (${failures}/${HEARTBEAT_MISS_LIMIT})`);
   416	      if (r.cancel) {
   417	        log(`[worker] ${ref}: ${HEARTBEAT_MISS_LIMIT} missed heartbeats — cancelling session`);
   418	        stop();
   419	        onExhausted();
   420	      }
   421	    });
   422	  }, HEARTBEAT_INTERVAL_MS);
   423	  timer.unref?.();
   424	  const stop = () => clearInterval(timer);
   425	  return stop;
   426	}
