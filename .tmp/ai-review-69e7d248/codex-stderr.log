  1034	/**
  1035	 * Fast, cheap scan of the global event feed for answered escalations
  1036	 * (needs_input_cleared) and questions addressed to agents (agent_question,
  1037	 * SYD-56). The server releases the claim when an escalation is answered, so
  1038	 * that issue is already back in `todo` — this poll just collapses the wait
  1039	 * for the next full tick from `intervalSeconds` down to `eventPollSeconds`,
  1040	 * and primes the resumed session's prompt to read the answer. An
  1041	 * agent_question dispatches a read-only answerer-mode session immediately,
  1042	 * independent of the issue's status (answering doesn't touch the triage
  1043	 * gate — see dispatchAnswer). `role` (SYD-67) gates which half acts: a
  1044	 * "code"-only worker never dispatches answer sessions; an "answer"-only
  1045	 * worker never resumes work dispatch. Both scans always run regardless of
  1046	 * role so the shared eventCursor still advances correctly either way.
  1047	 */
  1048	async function pollEvents(
  1049	  config: WorkerConfig,
  1050	  token: string,
  1051	  role: WorkerRole,
  1052	  opts: { dryRun: boolean },
  1053	): Promise<void> {
  1054	  const url = `${config.url.replace(/\/$/, "")}/api/events?limit=100`;
  1055	  const res = await fetch(url, { headers: { authorization: `Bearer ${token}` } });
  1056	  if (!res.ok) {
  1057	    throw new Error(`GET /api/events failed: ${res.status} ${await res.text()}`);
  1058	  }
  1059	  const feed = (await res.json()) as FeedEvent[];
  1060	  const { refs, lastEventId } = findResumeRefs(feed, config, eventCursor);
  1061	  const { refs: answerRefs } = findAnswerRefs(feed, config, eventCursor);
  1062	  eventCursor = lastEventId;
  1063	
  1064	  if (roleRunsAnswer(role)) {
  1065	    for (const ref of answerRefs) {
  1066	      console.log(`question addressed to an agent on ${ref} — dispatching an answer session`);
  1067	      dispatchAnswer(ref, config, token, opts);
  1068	    }
  1069	  }
  1070	
  1071	  if (roleRunsCode(role) && refs.length > 0) {
  1072	    for (const ref of refs) resumeRefs.add(ref);
  1073	    console.log(`escalation answered on ${refs.join(", ")} — dispatching now`);
  1074	    await runTick(config, token, role, opts);
  1075	  }
  1076	}
