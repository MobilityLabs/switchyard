   114	export function buildApiRoutes(db: Db, attachmentsDir: string = defaultAttachmentsDir()) {
   115	  const app = new Hono<Env>();
   116	
   117	  app.use("*", async (c, next) => {
   118	    const authz = c.req.header("authorization") ?? "";
   119	    let actor: Actor | null = null;
   120	    if (authz.startsWith("Bearer ")) actor = authenticate(db, authz.slice(7));
   121	    if (!actor) {
