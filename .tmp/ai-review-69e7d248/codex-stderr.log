     9	 * Releases `in_progress` issues whose newest event is older than `maxIdleSeconds`.
    10	 * Issues with `needsInput` set are skipped — an agent that escalated correctly
    11	 * (via request_human_input) is waiting on a human, not idling, and must not be
    12	 * cycled back to `todo` and re-dispatched.
    13	 * For each released issue: status -> todo, assignee cleared, and a
    14	 * `claim_released` event is recorded (attributed to the assignee if set, else
    15	 * the creator). Returns the number of issues released.
    16	 *
    17	 * `process_deviation` events are excluded from the idle computation (SYD-188):
    18	 * that signal is itself derived from this same idle clock, so recording one at
    19	 * ~now must not reset the clock and delay auto-release.
    20	 */
    21	export function releaseStaleClaims(
    22	  db: Db,
    23	  maxIdleSeconds: number = getSetting(db, "claims.stale_seconds"),
    24	): number {
    25	  const now = Math.floor(Date.now() / 1000);
    26	  const cutoff = now - maxIdleSeconds;
    27	
    28	  const inProgress = db.select().from(issues).where(eq(issues.status, "in_progress")).all();
    29	
    30	  let released = 0;
    31	  for (const issue of inProgress) {
    32	    if (issue.needsInput) continue; // an agent that escalated correctly must not be punished
    33	    // SYD-210: a leased claim is governed by lease expiry (8h TTL), not the 4h
    34	    // idle guess — a healthy quiet container keeps its lease. Only lease-less
    35	    // claims (none after the hard cutover) still fall to this idle sweep.
    36	    if (getActiveLease(db, issue.id)) continue;
    37	    const newest = db
    38	      .select({ createdAt: max(events.createdAt) })
    39	      .from(events)
    40	      .where(and(eq(events.issueId, issue.id), ne(events.type, "process_deviation")))
    41	      .get();
    42	    const newestCreatedAt = newest?.createdAt ?? issue.createdAt;
    43	    if (newestCreatedAt > cutoff) continue;
    44	
    45	    const idleSeconds = now - newestCreatedAt;
    46	    const actorId = issue.assigneeId ?? issue.creatorId;
    47	    const wasReleased = db.transaction((tx) => {
    48	      // Re-assert status/needsInput inside the UPDATE's WHERE so a second writer
    49	      // (e.g. src/cli.ts's own connection) that claimed or escalated this issue
    50	      // between the read above and this transaction wins the race atomically —
    51	      // .changes === 0 means someone else touched it first, so we skip the event.
    52	      const result = tx
    53	        .update(issues)
    54	        .set({ status: "todo", assigneeId: null, updatedAt: sql`(unixepoch())` })
    55	        .where(
    56	          and(
    57	            eq(issues.id, issue.id),
    58	            eq(issues.status, "in_progress"),
    59	            eq(issues.needsInput, false),
    60	          ),
    61	        )
    62	        .run();
