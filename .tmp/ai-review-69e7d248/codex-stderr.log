    17	import { formatSdkEvent, type SdkEventLike } from "./sdk-format.js";
    18	
    19	export type SdkSessionOpts = {
    20	  prompt: string;
    21	  cwd: string;
    22	  switchyardUrl: string;
    23	  switchyardToken: string;
    24	  /** SYD-210 Layer B: the session-scoped claim lease, sent as the
    25	   * X-Switchyard-Lease MCP header so claim-scoped writes carry it — never in
    26	   * argv, never in the LLM transcript. Omitted for non-lease (answer) sessions. */
    27	  switchyardLeaseToken?: string;
    28	  allowedTools: string[];
    29	  logPath: string;
    30	  /** Watchdog (SYD-115): abort the query if it runs longer than this. No timeout when omitted. */
    31	  timeoutMs?: number;
    32	  /** SYD-210 Layer B: host-side cancellation — the worker aborts the query when
    33	   * its lease heartbeat has failed N times in a row. */
    34	  externalAbortSignal?: AbortSignal;
    35	};
    36	
    37	/** Run one issue's session to completion. Resolves to an exit-code-like
    38	 * number (0 = the session finished successfully) so the worker can treat SDK
    39	 * runs and child processes uniformly. Never throws for session-level errors —
    40	 * they're logged and reported as a nonzero result. */
    41	export async function runSdkSession(o: SdkSessionOpts): Promise<number> {
    42	  // Never let a log-write failure kill the session or reject this promise —
    43	  // the worker relies on it settling to free the concurrency slot.
    44	  const log = (line: string) => {
    45	    try {
    46	      appendFileSync(o.logPath, `${line}\n`);
    47	    } catch {
    48	      /* log dir gone or disk full — the session matters more than the log */
    49	    }
    50	  };
    51	  let exit = 1;
    52	  // Watchdog (SYD-115): an SDK query that never yields a `result` message
    53	  // (a stuck tool call, a wedged CLI subprocess under the hood) would
    54	  // otherwise hold its concurrency slot forever. abortController is the
    55	  // SDK's own cancellation mechanism — aborting stops the query and cleans
    56	  // up its resources so the `finally` below always runs.
    57	  const abortController = new AbortController();
    58	  // SYD-210 Layer B: fold the host's heartbeat-cancellation signal into the
    59	  // query's own abort so a lease the worker can no longer renew stops the run.
    60	  if (o.externalAbortSignal) {
    61	    if (o.externalAbortSignal.aborted) abortController.abort();
    62	    else o.externalAbortSignal.addEventListener("abort", () => abortController.abort());
    63	  }
    64	  const watchdog =
    65	    o.timeoutMs !== undefined
    66	      ? setTimeout(() => {
    67	          log(`[sdk] session exceeded ${o.timeoutMs! / 1000}s watchdog timeout — aborting`);
    68	          abortController.abort();
    69	        }, o.timeoutMs)
    70	      : null;
    71	  const headers: Record<string, string> = { Authorization: `Bearer ${o.switchyardToken}` };
    72	  if (o.switchyardLeaseToken) headers["X-Switchyard-Lease"] = o.switchyardLeaseToken;
    73	  try {
    74	    const stream = query({
    75	      prompt: o.prompt,
    76	      options: {
    77	        cwd: o.cwd,
    78	        permissionMode: "acceptEdits",
    79	        allowedTools: o.allowedTools,
    80	        abortController,
    81	        mcpServers: {
    82	          switchyard: {
    83	            type: "http",
    84	            url: `${o.switchyardUrl.replace(/\/$/, "")}/mcp`,
    85	            headers,
    86	          },
    87	        },
    88	      },
    89	    });
