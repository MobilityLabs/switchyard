   114	/**
   115	 * Marks the active lease of an issue invalidated (takeover / self-release /
   116	 * human-answer release). No-op if there is no active lease. The REASON is
   117	 * carried by the event the caller co-records (claim_released{reason} /
   118	 * lease_taken_over), not stored on the lease row.
   119	 */
   120	export function invalidateLease(tx: DbOrTx, issueId: number): void {
   121	  const active = getActiveLease(tx, issueId);
   122	  if (!active) return;
   123	  tx.update(claimLeases)
   124	    .set({ invalidatedAt: sql`(unixepoch())` })
