# Disposable worker image for Switchyard's containerized dispatch mode (SYD-30).
# The container clones the target repo inside itself, works on a branch, and
# pushes the branch back out — it never mutates the host filesystem directly.
FROM node:24-slim

# python3/make/g++ (SYD-224): node-gyp's toolchain, so native modules like
# better-sqlite3 build from source via its `node-gyp rebuild` fallback --
# prebuild-install's GitHub Releases fetch isn't reachable inside the
# session's egress allowlist (EGRESS_BASELINE in scripts/worker-select.ts).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Pinned so image rebuilds are reproducible (SYD-198) -- a plain `npm install -g
# @anthropic-ai/claude-code` would silently pick up whatever is newest at build
# time. Bump via `--build-arg CLAUDE_CODE_VERSION=x.y.z` or by editing the
# default below; see README's containerized-mode section for the update steps.
ARG CLAUDE_CODE_VERSION=2.1.220
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && claude --version

# SYD-253: install-guard.mjs dispatches to pnpm for target repos that commit
# pnpm-lock.yaml, but node:24-slim has no pnpm -- the dispatch died on ENOENT
# and the session started with no node_modules, the same silent failure the
# hexdi/HEX yarn report hit. (yarn needs no install: the official node image
# bundles classic 1.22.22 at /usr/local/bin/yarn. The `yarn --version` below
# asserts that, so a base-image bump that drops it breaks the build here
# rather than every pnpm/yarn dispatch at runtime.)
#
# A concrete pinned binary rather than `corepack enable` on purpose: corepack
# shims fetch whatever version a repo pins in "packageManager" lazily, at
# session start, from repo.yarnpkg.com -- which is NOT in the sidecar's
# allowlist (EGRESS_BASELINE in scripts/worker-select.ts allows the npm and
# yarn *registries*, registry.npmjs.org and registry.yarnpkg.com, but not
# corepack's distribution host), so a shim would reintroduce the same silent
# no-dependencies failure behind a network block. Pinned for reproducible
# rebuilds, same as CLAUDE_CODE_VERSION above.
ARG PNPM_VERSION=11.17.0
RUN npm install -g pnpm@${PNPM_VERSION} \
    && pnpm --version \
    && yarn --version

COPY scripts/container-entry.sh /entry.sh
COPY scripts/prime-workspace-trust.mjs /prime-workspace-trust.mjs
COPY scripts/install-guard.mjs /install-guard.mjs
RUN chmod +x /entry.sh

# Out-of-band attachment uploader (SYD-182): baked in so any dispatched worker
# can `switchyard-attach <ISSUE_REF> <FILE>` regardless of the target repo,
# streaming the bytes to the tracker instead of base64-ing them through an MCP
# tool arg. Shell wrapper (not a bare rename) so node runs the .mjs as ESM.
COPY scripts/attach.mjs /opt/switchyard/attach.mjs
RUN printf '#!/bin/sh\nexec node /opt/switchyard/attach.mjs "$@"\n' > /usr/local/bin/switchyard-attach \
    && chmod +x /usr/local/bin/switchyard-attach

# Run as the image's built-in non-root `node` user (SYD-117) instead of root
# -- narrows the blast radius of a compromised session and, combined with
# --security-opt no-new-privileges (worker-select.ts buildDockerArgs), stops
# it from regaining privilege inside the container. /work is where
# container-entry.sh clones the repo, so it needs to be node-writable before
# we drop root.
RUN mkdir -p /work && chown node:node /work
USER node
WORKDIR /work

ENTRYPOINT ["/bin/sh", "/entry.sh"]
