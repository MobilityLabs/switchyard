# No trailing slash: must also match a node_modules symlink (a dir-only
# pattern let a scratch symlink get committed and clobber real installs).
node_modules
*.db
*.db-*
.DS_Store
.superpowers/
dist/
switchyard-worker.json
.env
.tmp/

# SYD-189: track only the shared board-process config under .claude/ (the
# Stop-hook settings + slash commands). Ignore local cruft — git worktrees live
# under .claude/worktrees/, and settings.local.json is per-developer.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/skills/
