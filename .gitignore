# No trailing slash: must also match a node_modules symlink (a dir-only
# pattern let a scratch symlink get committed and clobber real installs).
node_modules
*.db
*.db-*
.DS_Store
.superpowers/
dist/
switchyard-worker.json
.env
.tmp/

# Key material and local signing test artifacts — never commit a private key.
# The anchored names are leftover FIDO/affirmation signing scratch; the patterns
# are a defensive net so a stray key can't slip in via `git add -A`.
/k
/k.pub
/allowed_signers
/sig.out
*.pem
id_ed25519*
id_ecdsa*
id_rsa*
*_sk
*_sk.pub

# SYD-189: track only the shared board-process config under .claude/ (the
# Stop-hook settings + slash commands). Ignore local cruft — git worktrees live
# under .claude/worktrees/, and settings.local.json is per-developer.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/skills/
