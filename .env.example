# Copy to .env (kept 0600, gitignored) and fill in what you need.
# All vars are optional — the server runs with just the defaults below.

# SQLite db path, opened/created on startup.
SWITCHYARD_DB=switchyard.db

# HTTP port the server listens on.
PORT=3300

# Directory where issue attachments (attach_file) are stored on disk.
ATTACHMENTS_DIR=./attachments

# Base URL used to build links (e.g. the login link printed by `mint-login`).
SWITCHYARD_URL=http://localhost:3300

# HMAC secret for verifying inbound GitHub webhook deliveries
# (POST /webhooks/github). Also set as the webhook's secret on the GitHub
# side. Deliveries are rejected with 501 if this is unset.
GITHUB_WEBHOOK_SECRET=

# Hours an issue can sit claimed with no activity before the webhook
# dispatcher releases the claim back to todo. Defaults to 4 when unset
# or invalid.
STALE_CLAIM_HOURS=4

# Set to 1 to mark the session cookie Secure (HTTPS-only). Leave unset when
# serving over plain HTTP (e.g. Tailscale IP), or logins will not stick.
SWITCHYARD_COOKIE_SECURE=
